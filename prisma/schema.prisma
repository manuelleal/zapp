generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Competencia {
  id     String @id @default(cuid())
  codigo String @unique
  nombre String
  raps   RAP[]
  users  User[]
}

model RAP {
  id                 String               @id @default(cuid())
  competenciaId      String
  codigo             String
  descripcion        String
  criterios          Criterio[]
  feedbacks          AIFeedback[]
  evidenciaRels      RapEvidenciaRel[]
  matchingPropuestas MatchingPropuesta[]
  competencia        Competencia          @relation(fields: [competenciaId], references: [id])

  @@unique([competenciaId, codigo])
}

model Criterio {
  id          String @id @default(cuid())
  rapId       String
  descripcion String
  orden       Int    @default(0)
  rap         RAP    @relation(fields: [rapId], references: [id])
}

model User {
  id                String       @id @default(cuid())
  nombre            String
  email             String       @unique
  passwordHash      String
  zajunaUserEnc     String
  zajunaPassEnc     String
  competenciaCodigo String
  competenciaNombre String
  competenciaId     String?
  createdAt         DateTime     @default(now())
  lastAutoScanAt    DateTime?
  fichas             Ficha[]
  jobs               Job[]
  configAudits       ConfigAudit[]
  configChangeJobs   ConfigChangeJob[]
  matchingPropuestas MatchingPropuesta[]
  actas              ActaSeguimiento[]
  mensajesFormativos MensajeFormativo[]
  configCorreo       ConfigCorreo?
  competencia        Competencia?         @relation(fields: [competenciaId], references: [id])
}

model Ficha {
  id         String     @id @default(cuid())
  userId     String
  codigo     String
  programa   String     @default("")
  courseId   Int
  nombre     String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  archivedAt DateTime?
  user       User       @relation(fields: [userId], references: [id])
  evidencias         Evidencia[]
  aprendices         Aprendiz[]
  actas              ActaSeguimiento[]
  mensajesFormativos MensajeFormativo[]

  @@unique([userId, codigo])
}

model Evidencia {
  id             String           @id @default(cuid())
  fichaId        String
  nombre         String
  href           String
  tipo           String           @default("assign")
  cerradaAt      DateTime?
  configCache    Json?
  configCacheAt  DateTime?
  activaParaScan Boolean          @default(false)
  calificandoAt  DateTime?
  ficha              Ficha               @relation(fields: [fichaId], references: [id])
  entregas           Entrega[]
  configAudits       ConfigAudit[]
  evidenciaConfigs   EvidenciaConfig[]
  rapRels            RapEvidenciaRel[]
  matchingPropuestas MatchingPropuesta[]

  @@unique([fichaId, href])
}

model EvidenciaConfig {
  id          String    @id @default(cuid())
  evidenciaId String
  raw         Json
  scannedAt   DateTime  @default(now())
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id])
}

model Aprendiz {
  id            String    @id @default(cuid())
  fichaId       String
  nombre        String
  moodleId      String?
  documento     String?
  email         String?
  ultimoAcceso  DateTime?
  ficha           Ficha              @relation(fields: [fichaId], references: [id])
  entregas        Entrega[]
  participaciones ActaParticipante[]

  @@unique([fichaId, nombre])
}

model Entrega {
  id           String           @id @default(cuid())
  evidenciaId  String
  aprendizId   String
  estado       String
  fechaScan    DateTime         @default(now())
  moodlePostId String?
  notaActual   Float?
  evidencia    Evidencia        @relation(fields: [evidenciaId], references: [id])
  aprendiz     Aprendiz         @relation(fields: [aprendizId], references: [id])
  historial    HistorialEstado[]
  aiFeedback   AIFeedback[]

  @@unique([evidenciaId, aprendizId])
}

model HistorialEstado {
  id             String   @id @default(cuid())
  entregaId      String
  estadoAnterior String
  estadoNuevo    String
  fecha          DateTime @default(now())
  entrega        Entrega  @relation(fields: [entregaId], references: [id])
}

model AIFeedback {
  id                   String   @id @default(cuid())
  entregaId            String
  rapId                String?
  tipo                 String
  calificacionSugerida String?
  contenido            String
  generadoAt           DateTime @default(now())
  entrega              Entrega  @relation(fields: [entregaId], references: [id])
  rap                  RAP?     @relation(fields: [rapId], references: [id])
}

model Job {
  id        String   @id @default(cuid())
  userId    String
  tipo      String
  fichaId   String?
  status    String   @default("queued")
  progreso  Int      @default(0)
  errorMsg  String?
  resultado Json?
  creadoAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ConfigAudit {
  id          String    @id @default(cuid())
  userId      String
  evidenciaId String
  actId       String
  antes       Json
  despues     Json
  fecha       DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id])
}

model ConfigChangeJob {
  id           String   @id @default(cuid())
  userId       String
  fichaId      String?
  evidenciaIds Json
  campo        String
  valorDespues String
  status       String   @default("queued")
  errorMsg     String?
  progreso     Int      @default(0)
  detalle      Json?
  creadoAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

// ─── Módulo 4+5: RAPs ↔ Evidencias ──────────────────────────────────────────
// Para migrar: npx prisma migrate dev --name rap_evidencia_rel

model RapEvidenciaRel {
  id          String    @id @default(cuid())
  rapId       String
  evidenciaId String
  createdAt   DateTime  @default(now())
  rap         RAP       @relation(fields: [rapId], references: [id])
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id])

  @@unique([rapId, evidenciaId])
}

// ─── Módulo 6: Matching IA Evidencias ↔ RAPs ─────────────────────────────────
// Para migrar: npx prisma migrate dev --name matching_propuesta

model MatchingPropuesta {
  id          String    @id @default(cuid())
  userId      String
  evidenciaId String
  rapId       String
  confianza   Int
  razon       String
  estado      String    @default("propuesto")
  decidedAt   DateTime?
  creadoAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id])
  rap         RAP       @relation(fields: [rapId], references: [id])

  @@unique([userId, evidenciaId, rapId])
}

// ─── Módulo 7: Actas de Seguimiento + Mensajes Formales ─────────────────────
// Para migrar: npx prisma migrate dev --name actas_mensajes_formativos

model ActaSeguimiento {
  id           String   @id @default(cuid())
  userId       String
  fichaId      String
  numero       String
  fecha        DateTime
  hora         String
  lugar        String   @default("Videoconferencia / Plataforma Zajuna")
  objetivo     String
  conclusiones String?
  compromisos  Json?
  rapIds       Json
  estado       String   @default("borrador")
  notas        String?
  archivadaAt  DateTime?
  creadoAt     DateTime @default(now())
  user          User               @relation(fields: [userId],  references: [id])
  ficha         Ficha              @relation(fields: [fichaId], references: [id])
  participantes ActaParticipante[]
  mensajes      MensajeFormativo[]
}

model ActaParticipante {
  id          String  @id @default(cuid())
  actaId      String
  aprendizId  String
  juicio      String
  rapStatus   Json?
  hasUngraded Boolean @default(false)
  acta     ActaSeguimiento @relation(fields: [actaId],     references: [id])
  aprendiz Aprendiz        @relation(fields: [aprendizId], references: [id])

  @@unique([actaId, aprendizId])
}

// ─── Módulo 8: Configuración SMTP por instructor (mensajería masiva) ─────────
// Para migrar: npx prisma migrate dev --name mensajes_email_smtp

model ConfigCorreo {
  id            String   @id @default(cuid())
  userId        String   @unique
  smtpHost      String
  smtpPort      Int      @default(587)
  smtpUser      String
  smtpPassEnc   String
  fromNombre    String?
  user          User     @relation(fields: [userId], references: [id])
  creadaAt      DateTime @default(now())
  actualizadaAt DateTime @updatedAt
}

model MensajeFormativo {
  id            String    @id @default(cuid())
  userId        String
  actaId        String?
  fichaId       String
  canal         String
  asunto        String
  cuerpo        String
  destinatarios Json
  enviadoAt     DateTime?
  estado        String    @default("pendiente")
  errorMsg      String?
  templateTipo  String?
  creadoAt      DateTime  @default(now())
  user  User              @relation(fields: [userId],  references: [id])
  acta  ActaSeguimiento?  @relation(fields: [actaId],  references: [id])
  ficha Ficha             @relation(fields: [fichaId], references: [id])
}
