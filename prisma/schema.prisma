generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Competencia {
  id     String @id @default(cuid())
  codigo String @unique
  nombre String
  raps   RAP[]
  users  User[]
}

model RAP {
  id                 String               @id @default(cuid())
  competenciaId      String
  codigo             String
  descripcion        String
  criterios          Criterio[]
  feedbacks          AIFeedback[]
  evidenciaRels      RapEvidenciaRel[]
  matchingPropuestas MatchingPropuesta[]
  competencia        Competencia          @relation(fields: [competenciaId], references: [id])

  @@unique([competenciaId, codigo])
}

model Criterio {
  id          String @id @default(cuid())
  rapId       String
  descripcion String
  orden       Int    @default(0)
  rap         RAP    @relation(fields: [rapId], references: [id])
}

model User {
  id                String       @id @default(cuid())
  nombre            String
  email             String       @unique
  passwordHash      String
  zajunaUserEnc     String
  zajunaPassEnc     String
  competenciaCodigo String
  competenciaNombre String
  competenciaId     String?
  createdAt         DateTime     @default(now())
  lastAutoScanAt    DateTime?
  fichas             Ficha[]
  jobs               Job[]
  configAudits       ConfigAudit[]
  configChangeJobs   ConfigChangeJob[]
  matchingPropuestas MatchingPropuesta[]
  actas              ActaSeguimiento[]
  mensajesFormativos MensajeFormativo[]
  mensajesProgramados MensajeProgramado[]
  configCorreo       ConfigCorreo?
  competencia        Competencia?         @relation(fields: [competenciaId], references: [id])
}

model Ficha {
  id         String     @id @default(cuid())
  userId     String
  codigo     String
  programa   String     @default("")
  courseId   Int
  nombre     String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  archivedAt DateTime?
  user       User       @relation(fields: [userId], references: [id])
  evidencias         Evidencia[]
  aprendices         Aprendiz[]
  actas              ActaSeguimiento[]
  mensajesFormativos MensajeFormativo[]
  mensajesProgramados MensajeProgramado[]

  @@unique([userId, codigo])
  // Listados de fichas del instructor (toda la app filtra por userId, regla #1).
  @@index([userId])
}

model Evidencia {
  id             String           @id @default(cuid())
  fichaId        String
  nombre         String
  href           String
  tipo           String           @default("assign")
  cerradaAt      DateTime?
  configCache    Json?
  configCacheAt  DateTime?
  activaParaScan Boolean          @default(false)
  calificandoAt  DateTime?
  // CAPA 2 (perf): cache del instance id (assignid) y contextid resueltos desde
  // el cmid. mod_assign_list_participants exige assignid, no el cmid del href.
  // SENA tiene capadas mod_assign_get_assignments / core_course_get_contents, así
  // que se resuelven una vez leyendo data-assignmentid del grader HTML y se cachean.
  assignId       Int?
  contextId      Int?
  // itemid del libro de calificaciones (grade item). Permite casar nota↔evidencia
  // por id determinista (como la Extensión Z) en vez de por nombre de columna.
  itemid         Int?
  ficha              Ficha               @relation(fields: [fichaId], references: [id])
  entregas           Entrega[]
  configAudits       ConfigAudit[]
  evidenciaConfigs   EvidenciaConfig[]
  rapRels            RapEvidenciaRel[]
  matchingPropuestas MatchingPropuesta[]

  @@unique([fichaId, href])
  // El scan y las actas listan evidencias por ficha (findMany { fichaId }).
  // El unique [fichaId, href] ya cubre fichaId por prefijo, pero este índice
  // simple es más liviano para los scans frecuentes de solo fichaId.
  @@index([fichaId])
}

model EvidenciaConfig {
  id          String    @id @default(cuid())
  evidenciaId String
  raw         Json
  scannedAt   DateTime  @default(now())
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id])
}

model Aprendiz {
  id            String    @id @default(cuid())
  fichaId       String
  nombre        String
  moodleId      String?
  documento     String?
  email         String?
  ultimoAcceso  DateTime?
  ficha           Ficha              @relation(fields: [fichaId], references: [id])
  entregas        Entrega[]
  participaciones ActaParticipante[]

  @@unique([fichaId, nombre])
  // Preload de aprendices por ficha en el scan (CAPA 1) y en actas.
  @@index([fichaId])
}

model Entrega {
  id           String           @id @default(cuid())
  evidenciaId  String
  aprendizId   String
  estado       String
  fechaScan    DateTime         @default(now())
  moodlePostId String?
  notaActual   Float?
  // Nota cualitativa de la escala SENA (A=Aprobado / D=Deficiente). Muchos cursos
  // califican con letra, no con número; antes se perdía (parseFloat("A")=NaN).
  notaCualitativa String?
  evidencia    Evidencia        @relation(fields: [evidenciaId], references: [id])
  aprendiz     Aprendiz         @relation(fields: [aprendizId], references: [id])
  historial    HistorialEstado[]
  aiFeedback   AIFeedback[]

  @@unique([evidenciaId, aprendizId])
  // El unique cubre evidenciaId por prefijo; falta el camino inverso:
  // historial/juicios por aprendiz (actas recorren entregas de cada aprendiz).
  @@index([aprendizId])
}

model HistorialEstado {
  id             String   @id @default(cuid())
  entregaId      String
  estadoAnterior String
  estadoNuevo    String
  fecha          DateTime @default(now())
  entrega        Entrega  @relation(fields: [entregaId], references: [id])

  // Timeline de estados por entrega (FK sin índice automático en Postgres).
  @@index([entregaId])
}

model AIFeedback {
  id                   String   @id @default(cuid())
  entregaId            String
  rapId                String?
  tipo                 String
  calificacionSugerida String?
  contenido            String
  generadoAt           DateTime @default(now())
  entrega              Entrega  @relation(fields: [entregaId], references: [id])
  rap                  RAP?     @relation(fields: [rapId], references: [id])
}

model Job {
  id        String   @id @default(cuid())
  userId    String
  tipo      String
  fichaId   String?
  status    String   @default("queued")
  progreso  Int      @default(0)
  errorMsg  String?
  resultado Json?
  creadoAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  // Listado/polling de jobs del instructor (Dashboard consulta por userId).
  @@index([userId])
}

model ConfigAudit {
  id          String    @id @default(cuid())
  userId      String
  evidenciaId String
  actId       String
  antes       Json
  despues     Json
  fecha       DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id])
}

model ConfigChangeJob {
  id           String   @id @default(cuid())
  userId       String
  fichaId      String?
  evidenciaIds Json
  campo        String
  valorDespues String
  status       String   @default("queued")
  errorMsg     String?
  progreso     Int      @default(0)
  detalle      Json?
  creadoAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

// ─── Módulo 4+5: RAPs ↔ Evidencias ──────────────────────────────────────────
// Para migrar: npx prisma migrate dev --name rap_evidencia_rel

model RapEvidenciaRel {
  id          String    @id @default(cuid())
  rapId       String
  evidenciaId String
  createdAt   DateTime  @default(now())
  rap         RAP       @relation(fields: [rapId], references: [id])
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id])

  @@unique([rapId, evidenciaId])
  // actas.js arma el mapa RAP→evidencias consultando por ambos lados.
  // El unique ya cubre rapId por prefijo; el índice simple es más liviano.
  @@index([rapId])
  @@index([evidenciaId])
}

// ─── Módulo 6: Matching IA Evidencias ↔ RAPs ─────────────────────────────────
// Para migrar: npx prisma migrate dev --name matching_propuesta

model MatchingPropuesta {
  id          String    @id @default(cuid())
  userId      String
  evidenciaId String
  rapId       String
  confianza   Int
  razon       String
  estado      String    @default("propuesto")
  decidedAt   DateTime?
  creadoAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id])
  rap         RAP       @relation(fields: [rapId], references: [id])

  @@unique([userId, evidenciaId, rapId])
  // actas.js busca propuestas aceptadas por RAP (where { rapId, estado }).
  @@index([rapId, estado])
}

// ─── Módulo 7: Actas de Seguimiento + Mensajes Formales ─────────────────────
// Para migrar: npx prisma migrate dev --name actas_mensajes_formativos

model ActaSeguimiento {
  id           String   @id @default(cuid())
  userId       String
  fichaId      String
  numero       String
  fecha        DateTime
  hora         String
  lugar        String   @default("Videoconferencia / Plataforma Zajuna")
  objetivo     String
  conclusiones String?
  compromisos  Json?
  rapIds       Json
  estado       String   @default("borrador")
  notas        String?
  archivadaAt  DateTime?
  creadoAt     DateTime @default(now())
  user          User               @relation(fields: [userId],  references: [id])
  ficha         Ficha              @relation(fields: [fichaId], references: [id])
  participantes ActaParticipante[]
  mensajes      MensajeFormativo[]

  // Listado de actas por ficha en la UI de actas.
  @@index([fichaId])
}

model ActaParticipante {
  id          String  @id @default(cuid())
  actaId      String
  aprendizId  String
  juicio      String
  rapStatus   Json?
  hasUngraded Boolean @default(false)
  acta     ActaSeguimiento @relation(fields: [actaId],     references: [id])
  aprendiz Aprendiz        @relation(fields: [aprendizId], references: [id])

  @@unique([actaId, aprendizId])
}

// ─── Módulo 8: Configuración SMTP por instructor (mensajería masiva) ─────────
// Para migrar: npx prisma migrate dev --name mensajes_email_smtp

model ConfigCorreo {
  id            String   @id @default(cuid())
  userId        String   @unique
  smtpHost      String
  smtpPort      Int      @default(587)
  smtpUser      String
  smtpPassEnc   String
  fromNombre    String?
  user          User     @relation(fields: [userId], references: [id])
  creadaAt      DateTime @default(now())
  actualizadaAt DateTime @updatedAt
}

model MensajeFormativo {
  id            String    @id @default(cuid())
  userId        String
  actaId        String?
  fichaId       String
  canal         String
  asunto        String
  cuerpo        String
  destinatarios Json
  enviadoAt     DateTime?
  estado        String    @default("pendiente")
  errorMsg      String?
  templateTipo  String?
  creadoAt      DateTime  @default(now())
  user  User              @relation(fields: [userId],  references: [id])
  acta  ActaSeguimiento?  @relation(fields: [actaId],  references: [id])
  ficha Ficha             @relation(fields: [fichaId], references: [id])
}

// Envío masivo recurrente: guarda el FILTRO, no los destinatarios — el worker
// los recalcula EN CADA corrida (los pendientes de hoy, no los de cuando se
// programó). Cada corrida genera un MensajeFormativo normal (queda en historial).
model MensajeProgramado {
  id                  String    @id @default(cuid())
  userId              String
  fichaId             String
  canal               String    // email | zajuna
  asunto              String
  cuerpo              String
  templateTipo        String?
  // todos | con_pendientes | con_desaprobadas | inactivos | nunca
  filtroDestinatarios String
  // competencia (la del instructor) | todas (líder de ficha) | ids (selección manual)
  alcanceEvidencias   String    @default("competencia")
  evidenciaIds        Json?     // string[] cuando alcanceEvidencias = "ids"
  incluirDesaprobadas Boolean   @default(false)
  intervaloDias       Int       // cada N días (mínimo 1 — tope anti-spam)
  hora                String    // "HH:mm" hora local del servidor
  proximaEjecucion    DateTime  // el tick dispara cuando <= now (y la re-agenda)
  lastRunAt           DateTime?
  pausadoAt           DateTime? // soft-state (regla #4): null = activo
  creadoAt            DateTime  @default(now())
  user  User  @relation(fields: [userId],  references: [id])
  ficha Ficha @relation(fields: [fichaId], references: [id])

  // El tick busca vencidos: pausadoAt null + proximaEjecucion <= now.
  @@index([proximaEjecucion])
  @@index([userId])
}
