# ─── Credenciales Zajuna (solo para tests manuales/seed; en prod cada instructor
#     guarda las suyas cifradas en DB) ──────────────────────────────────────────
ZAJUNA_USER=
ZAJUNA_PASS=

# ─── Infraestructura ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://zajuna:zajuna@localhost:5432/zajuna
REDIS_URL=redis://localhost:6379

# ─── Secretos (generar nuevos en cada entorno) ────────────────────────────────
# JWT_SECRET:      openssl rand -hex 32
# ENCRYPTION_KEY:  openssl rand -hex 32   (64 chars hex = AES-256)
JWT_SECRET=
ENCRYPTION_KEY=

# Dominio permitido para CORS. En producción: la URL real del frontend (https://...).
ALLOWED_ORIGIN=http://localhost:3000

# Email del superadmin (acceso al Simulador de Competencias). Sin esto, nadie es superadmin.
SUPERADMIN_EMAIL=

# ─── IA — Matching RAP↔evidencia (matchingIaWorker / actaSaneado) ──────────────
# AI_PROVIDER: auto | openrouter | kimi | anthropic   (auto elige según las keys presentes)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=moonshotai/kimi-k2
